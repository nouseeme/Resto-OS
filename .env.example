# Optional cloud configuration; leave unset to use local SQLite.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Browser Realtime configuration and anonymous-access security tests:
SUPABASE_PUBLISHABLE_KEY=
# Optional provider helpers:
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# RESTO_DB=data/development.sqlite
# RESTO_SECURE_COOKIE=1

# Demo deployment (exactly "true" enables; false/unset uses normal database configuration)
APP_DEMO_MODE=false
